{
  "name": "hyperchess-wasm",
  "version": "0.1.1",
  "description": "HyperChess game logic + 3D board rendering compiled to WebAssembly \u2014 a thin JS wrapper around crates/hyperchess-wasm (WasmBoard + Scene3D), not a separate implementation.",
  "type": "module",
  "main": "./dist/bundler/hyperchess_wasm.js",
  "types": "./dist/bundler/hyperchess_wasm.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/nodejs/hyperchess_wasm.d.ts",
        "require": "./dist/nodejs/hyperchess_wasm.js",
        "import": "./dist/nodejs/hyperchess_wasm.js"
      },
      "default": {
        "import": "./dist/bundler/hyperchess_wasm.js",
        "types": "./dist/bundler/hyperchess_wasm.d.ts"
      }
    },
    "./nodejs": {
      "types": "./dist/nodejs/hyperchess_wasm.d.ts",
      "require": "./dist/nodejs/hyperchess_wasm.js",
      "import": "./dist/nodejs/hyperchess_wasm.js"
    },
    "./bundler": {
      "import": "./dist/bundler/hyperchess_wasm.js",
      "types": "./dist/bundler/hyperchess_wasm.d.ts"
    },
    "./web": {
      "import": "./dist/web/hyperchess_wasm.js",
      "types": "./dist/web/hyperchess_wasm.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "../../scripts/build-wasm-sdk.sh"
  },
  "keywords": [
    "hyperchess",
    "chess",
    "wasm",
    "webassembly",
    "game",
    "engine",
    "webgpu"
  ],
  "author": "HyperChess Contributors",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyrpyDev/hyperchess-core.git",
    "directory": "packages/wasm"
  },
  "homepage": "https://github.com/KyrpyDev/hyperchess-core#readme",
  "bugs": {
    "url": "https://github.com/KyrpyDev/hyperchess-core/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
